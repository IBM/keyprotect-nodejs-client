{
  "name": "@ibm-cloud/ibm-key-protect",
  "version": "0.4.7",
  "description": "IBM Cloud Key Protect Node SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/IBM/keyprotect-nodejs-client"
  },
  "keywords": [
    "ibm",
    "key-management-service"
  ],
  "author": "IBM Corp.",
  "scripts": {
    "eslint:fix": "eslint . --fix",
    "eslint:check": "eslint . --cache",
    "lint": "npm run eslint:check",
    "lint-fix": "npm run eslint:fix",
    "build": "tsc && cp package.json dist/ && cp README.md dist/",
    "prepublishOnly": "npm run build",
    "postversion": "tsc-publish --no-checks --dry-run",
    "jest": "jest",
    "test": "npm run build && npm run lint && jest test/",
    "test-unit": "npm run build && jest test/unit/",
    "test-integration": "npm run build && jest test/integration",
    "test-unit-travis": "jest --runInBand test/unit/",
    "test-integration-travis": "jest --runInBand --no-colors --testNamePattern='^((?!@slow).)*$' --json test/integration > test-output.log",
    "report-coverage": "codecov",
    "check-packages": "installed-check -e -d -v",
    "semantic-release": "semantic-release"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@ibm-cloud/platform-services": "^0.86.3",
    "@types/node": "^26.6.6",
    "extend": "^3.0.2",
    "ibm-cloud-sdk-core": "^5.9.3"
  },
  "overrides": {
    "axios": "^1.21.0",
    "form-data": "^4.0.6",
    "lodash-es": "^4.18.1",
    "undici": "^7.30.1",
    "@actions/http-client": {
      "undici": "^7.30.1"
    },
    "js-yaml": "^4.3.2",
    "npm": "^11.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ibm-cloud/sdk-test-utilities": "^1.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "semantic-release": "^25.0.9",
    "@types/eslint__js": "^9.14.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "axios": "^1.21.0",
    "eslint": "^10.14.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.7",
    "installed-check": "^11.0.0",
    "jest": "^30.5.2",
    "nock": "^15.0.5",
    "prettier": "^3.9.10",
    "tsc-publish": "^0.5.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "jest": {
    "collectCoverage": true,
    "coverageDirectory": "./coverage/",
    "coveragePathIgnorePatterns": [
      "<rootDir>/test/"
    ],
    "testEnvironment": "node"
  }
}
